<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- colorAccent tints native View-based UI outside Compose's control — specifically
         the WebView editor's text cursor/selection handles (Compose's MaterialTheme
         primary color, already yellow, has no effect on WebView-hosted content). -->
    <style name="Theme.NotesTN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/notes_yellow</item>
        <!-- WebView's Chromium-drawn selection handles read colorControlActivated
             directly, not colorAccent — set both explicitly rather than relying
             on the framework's colorAccent -> colorControlActivated cascade. -->
        <item name="android:colorControlActivated">@color/notes_yellow</item>
        <!-- TEST: colorAccent/colorControlActivated alone didn't change the WebView
             handle color (known Chromium limitation — see conversation). Trying a
             direct drawable override instead, which supplies an already-yellow
             asset rather than relying on WebView to tint it. Revert if this also
             has no effect. -->
        <item name="android:textSelectHandle">@drawable/text_select_handle_notes</item>
        <item name="android:textSelectHandleLeft">@drawable/text_select_handle_notes</item>
        <item name="android:textSelectHandleRight">@drawable/text_select_handle_notes</item>
    </style>
</resources>